# SJC_Intel .gitignore
# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/
venv/

# Secrets and keys
*.key
*.pem

# Environment
.env
.env.local
*.secret*

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Generated/source data (committed - these are the repo's data assets)
# data/ is intentionally tracked

# Logs (committed - needed for session history)
# logs/ is intentionally tracked

# Large generated files
*.log

# Node (OpenCode runtime)
node_modules/

# Hermes worker runtime (regenerated per session)
runtime/

# Auto-generated Hermes worker context (regenerated per session)
WORKER_CONTEXT.md

# Weekly bundle staging (transient; receipts are tracked under data/receipts/)
data/incoming/

# Generated demo site output (regenerable from site/fixtures/demo; the real
# release under site/data/releases/ is tracked as the standalone MVP)
site/data/demo/

# Generated Hermes backtest weekly reasoning trees (LLM output, not reproducible).
# Only the 7 Task 30 pilot weeks are versioned as the reproducible proof; the
# other full-run weekly reasoning directories are regenerated by re-running
# Hermes and are excluded. See reports/30 and the backtest provenance manifest.
data/hermes_backtests/*/weeks/*
!data/hermes_backtests/*/weeks/2025-05-05/
!data/hermes_backtests/*/weeks/2025-08-18/
!data/hermes_backtests/*/weeks/2025-09-15/
!data/hermes_backtests/*/weeks/2025-12-01/
!data/hermes_backtests/*/weeks/2026-03-23/
!data/hermes_backtests/*/weeks/2026-06-22/
!data/hermes_backtests/*/weeks/2026-07-20/

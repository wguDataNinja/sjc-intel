# SJC Intel — Environment Variables
# DO NOT INSTALL OR ENABLE WITHOUT SCHEDULER GATE
#
# Copy to /home/scraper/config/sjc_intel.env on VPS.
# Fill in real values (secrets) in that file — never commit this file.
#
# Variable naming follows shared-conventions.md §5:
#   {PROJECT}_{VARIABLE} uppercase with project prefix.

# --- PostgreSQL ---

# Set to "true" to enable PG adapter (requires Database Authority Gate)
SJC_INTEL_PG_ADAPTER_ENABLED=false

# PostgreSQL connection URL (secret — do not commit real value)
# Format: postgresql://user:password@localhost:5432/sjc_intel
SJC_INTEL_PG_URL=postgresql://sjc_intel_writer:{{PASSWORD}}@localhost:5432/sjc_intel

# --- Paths ---

# Root data directory (file adapter storage)
SJC_INTEL_DATA_ROOT=/home/scraper/data/sjc-intel

# Raw capture directory
SJC_INTEL_RAW_ROOT=/home/scraper/data/sjc-intel/raw

# Export directory for generated artifacts
SJC_INTEL_EXPORT_ROOT=/home/scraper/data/sjc-intel/exports

# Health JSON output path (SHARED-003 sanitized format)
SJC_INTEL_HEALTH_OUTPUT=/home/scraper/data/sjc-intel/health/sjc_intel.health.json

# Backup directory for PostgreSQL dumps
SJC_INTEL_BACKUP_ROOT=/home/scraper/backups/postgres/sjc-intel

# --- Runtime ---

# Current migration version (set after each migration applied)
SJC_INTEL_MIGRATION_VERSION=0

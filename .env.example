# SJC_Intel — Environment Variables
# Copy to .env and fill as needed.
# Currently no scripts require env vars. These are for future use.

# Repo root (auto-detected from script location by default)
# SJC_INTEL_HOME=/path/to/sjc_intel

# Python path for script imports (auto-handled by scripts)
# PYTHONPATH=

# Hermes runtime (future)
# HERMES_HOME=
# HERMES_PROFILE=

# VPS deployment (future)
# SJC_INTEL_DATA=/home/scraper/data/sjc_intel
# SJC_INTEL_DB_URL=postgresql://localhost:5432/sjc_intel

# Logging (future)
# SJC_INTEL_LOG_LEVEL=INFO

# Storage adapter configuration
# Default: file (authoritative YAML backend)
# Set to "pg" to enable PostgreSQL adapter (requires live DB)
# SJC_INTEL_ADAPTER_BACKEND=file

# PostgreSQL adapter (disabled by default)
# SJC_INTEL_PG_ADAPTER_ENABLED=false

# PostgreSQL connection (required if PG adapter is enabled)
# SJC_INTEL_PG_URL=postgresql://localhost:5432/sjc_intel
# SJC_INTEL_PG_DATABASE=sjc_intel
# SJC_INTEL_PG_WRITER_USER=sjc_intel_writer
# SJC_INTEL_PG_READER_USER=sjc_intel_reader
